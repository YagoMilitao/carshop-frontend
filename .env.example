# Convenção de variáveis de ambiente (Next.js):
# - Prefixo `NEXT_PUBLIC_`: exposta ao bundle do navegador (client-side).
#   Nunca deve conter segredos/credenciais — qualquer um que inspecione o
#   bundle consegue ler o valor. Validada/tipada em `lib/env/client.ts`.
# - Sem prefixo `NEXT_PUBLIC_`: server-only, nunca vai para o bundle
#   cliente (ex.: `OBSIDIAN_VAULT_ID` abaixo). Variáveis server-only
#   exclusivas de runtime da aplicação são validadas/tipadas em
#   `lib/env/server.ts`.
# Nenhum outro arquivo da aplicação deve ler `process.env.NEXT_PUBLIC_API_URL`
# diretamente — use `clientEnv`/`serverEnv` desses dois módulos. Exceção
# documentada: `next.config.mjs` (fora do runtime Next/React).
NEXT_PUBLIC_API_URL=http://localhost:3333

# Opcional, dev-only: caminho relativo (mesma origem do frontend) usado
# pelo Axios client-side (lib/api/http.ts) no lugar de NEXT_PUBLIC_API_URL
# quando definido. Serve para rodar o frontend em localhost autenticando
# contra um backend remoto já deployado (ex.: Render), sem quebrar cookies
# HttpOnly host-bound (refresh_token/csrf_token). Depende de rewrites() em
# next.config.mjs, ativo apenas quando NODE_ENV === "development". Deixe em
# branco para o comportamento padrão (baseURL = NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_API_PROXY_PATH=

# Base absoluta do site público (sem barra final), usada por
# `metadataBase`, `app/robots.ts`, `app/sitemap.ts` e Open Graph.
# Validada/tipada em `lib/env/client.ts`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional, não-secreta: aponta a pasta/vault local do Obsidian usada pelo
# agente knowledge-reader para consultar conhecimento histórico do CarShop.
# Não é uma credencial de API (ver docs/context/obsidian.md). Server-only
# por convenção (sem prefixo `NEXT_PUBLIC_`), mas é lida por agentes de
# automação fora do runtime da aplicação Next.js, não por
# `lib/env/server.ts`.
OBSIDIAN_VAULT_ID=

# Opcionais, server-only (sem prefixo `NEXT_PUBLIC_`): URLs reais dos
# perfis da CarShop nas redes sociais, usadas pelo footer público
# (components/layout/footer.tsx). Validadas/tipadas em
# `lib/env/server.ts` (serverEnv.social.*). Cada link só é renderizado no
# footer se a variável correspondente estiver definida — deixar em branco
# omite o link, não gera um `href` inventado. Nunca preencher com valores
# de exemplo/placeholder não-funcionais (ver CARSHOP-133 e CARSHOP-22).
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_LINKEDIN_URL=
